---
import { getCollection } from "astro:content";

import BaseHead from "@/components/BaseHead.astro";
import CardProject from "@/components/CardProject.astro";
import ContainerText from "@/components/ContainerText.astro";
import FloatingIcons from "@/components/FloatingIcons.astro";
import Footer from "@/components/Footer.astro";
import GridProjects from "@/components/GridProjects.astro";
import GridSkills from "@/components/GridSkills.astro";
import Header from "@/components/Header.astro";
import WindowBox from "@/components/WindowBox.astro";

import dataSkills from "@/data/skills.json";

import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";

const skillsTextFirstColumn = [dataSkills.tecnicas, dataSkills.estrategicas];

const skillsTextSecondColumn = [dataSkills.analiticas, dataSkills.soft];

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
     <section class="more section-container" id="sobre-mim">
        <div class="container">
          <ContainerText>
            <WindowBox
              slot="window-element"
              title="Oi, sou a Camila"
              variant="dark"
            >
            <p class="text-window">
             Atualmente, trabalho como <b>Product Designer na Natura & Co</b>, focada em plataformas de educação para consultoras de beleza na América Latina. Antes disso, passei pela Rappi na vertical de entregadores, onde conduzia pesquisas de campo e prototipava soluções estratégicas.</p>
                <p>Com 10 anos de trajetória em tecnologia e <b>pós-graduada em UX Design pela PUCRS</b>, iniciei minha carreira como desenvolvedora front-end, tenho uma base sólida para trabalhar em sintonia com times técnicos. Minha abordagem combina <b>pesquisa, dados e estratégia de design</b> para conectar as necessidades dos usuários aos resultados do negócio.</p>
            </WindowBox>
            <figure>
              <img
                src="/images/camila-alves.png"
                alt="Camila Alves"
                width="502"
                height="404"
                loading="lazy"
                class="image-window"
              />
            </figure>
          </ContainerText>
        </div>
      </section>
      <section class="projects section-container" id="meu-trabalho">
        <div class="container">
          <h2 class="section-title text-pixel">Meu trabalho</h2>
          <GridProjects>
            {
              posts.map((post) => (
                <CardProject
                  title={post.data.title}
                  area={post.data.area}
                  image={post.data.heroImage}
                  link={`/blog/${post.id}/`}
                />
              ))
            }
          </GridProjects>
        </div>
      </section>
      
      <section class="skills section-container section-grid-bg">
        <div class="container">
          <h2 class="section-title text-pixel">Habilidades</h2>
          <GridSkills>
            <div class="skills-group">
              {
                skillsTextFirstColumn.map((skill) => {
                  return (
                    <WindowBox title={skill.title}>
                      <ul>
                        {skill.items.map((item) => {
                          return (
                            <li>
                              <strong>{item.strong}</strong>
                              {item.text}
                            </li>
                          );
                        })}
                      </ul>
                    </WindowBox>
                  );
                })
              }
            </div>
            <div class="skills-group">
              {
                skillsTextSecondColumn.map((skill) => {
                  return (
                    <WindowBox title={skill.title}>
                      <ul>
                        {skill.items.map((item) => {
                          return (
                            <li>
                              <strong>{item.strong}</strong>
                              {item.text}
                            </li>
                          );
                        })}
                      </ul>
                    </WindowBox>
                  );
                })
              }
            </div>
            <div class="skills-group">
              <WindowBox title={dataSkills.ferramentas.title}>
                <ul class="skills-tools">
                  {
                    dataSkills.ferramentas.tools.map((item) => {
                      return (
                        <li>
                          <img src={`/svg/logo-${item}.svg`} />
                        </li>
                      );
                    })
                  }
                </ul>
              </WindowBox>
              <WindowBox title={dataSkills.idiomas.title}>
                <ul class="skills-languages">
                  {
                    dataSkills.idiomas.languages.map((item) => {
                      return (
                        <li>
                          <img
                            src={`/images/flag-${item.flag}.webp`}
                          />
                          {item.text}
                        </li>
                      );
                    })
                  }
                </ul>
              </WindowBox>
            </div>
          </GridSkills>
        </div>
      </section>
      <section class="more section-container">
        <div class="container">
          <ContainerText>
            <WindowBox
              slot="window-element"
              title="Um pouco de mim"
              variant="dark"
            >
              <p class="text-window">
              Minha relação com o design nasce do encontro entre diferentes interesses criativos. A moda treinou meu olhar estético, a música ampliou minha sensibilidade e a fotografia me ensinou a observar o mundo com mais atenção. Essas influências moldam não só o que crio, mas principalmente como penso experiências. </p>
              <p class="text-window">
              Vejo o design como uma ferramenta para simplificar, conectar e tornar a tecnologia mais próxima das pessoas. Meu objetivo é criar experiências intuitivas, que se integrem no cotidiano e façam sentido para quem as utiliza.</p>
            </WindowBox>
            <FloatingIcons />
          </ContainerText>
        </div>
      </section>
    </main>
    <Footer showLargeContent={true} />

    <script>
      const palavras = ["soluções", "experiências", "produtos"];
      const textElement = document.getElementById("text");
      let palavraIndex = 0;
  
      function digitarTexto(texto: string, callback: () => void) {
        let i = 0;
        const intervalo = setInterval(() => {
          (textElement as HTMLElement).textContent += texto.charAt(i);
          i++;
          if (i === texto.length) {
            clearInterval(intervalo);
            setTimeout(callback, 5000); // espera antes de apagar
          }
        }, 100);
      }
  
      function apagarTexto(callback: () => void) {
        let texto = (textElement as HTMLElement).textContent;
        let i = texto ? texto?.length : 0;
        const intervalo = setInterval(() => {
          (textElement as HTMLElement).textContent = texto ? texto.substring(0, i - 1) : null;

          i--;

          if (i === 0) {
            clearInterval(intervalo);
            callback();
          }
        }, 50);
      }
  
      function loop() {
        digitarTexto(palavras[palavraIndex], () => {
          apagarTexto(() => {
            palavraIndex = (palavraIndex + 1) % palavras.length;
            loop();
          });
        });
      }
  
      loop();
    </script>

  </body>
</html>



<style>
  .blink {
    white-space: nowrap;
    overflow: hidden;
    border-right: 2px solid var(--color-dark-secondary-100);
    animation: blink-caret 0.7s step-end infinite;
  }

  .hero {
    padding-block: 32px;
    text-align: center;

    @container main-container (width >= 1024px) {
      padding-block: 136px;
    }

    .hide {
      @container main-container (width >= 1024px) {
        display: none;
      } 
    }
  }

  .hero-title {
    max-width: 920px;
    margin-inline: auto;
    font-weight: 700;
    font-size: 1.75rem;
    text-shadow: #ffffff25 1px 0 10px;

    @container main-container (width >= 1024px) {
      font-size: 3rem;
    }

    span {
      color: var(--color-dark-secondary-100);
    }
  }

  .hero-sub-title {
    font-weight: 500;
    font-size: 1rem;
    text-shadow: #ffffff25 1px 0 10px;

    @container main-container (width >= 1024px) {
      font-size: 1.25rem;
    }

    &:not(:last-child) {
      margin-block-end: 24px;
    }
  }

  .more {
    overflow: hidden;
  }

  .section-container {
    padding-block: 80px;

    @container main-container (width >= 1024px) {
      padding-block: 120px;
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 300;
    color: var(--_section-title-color, var(--color-white));

    @container main-container (width >= 1024px) {
      font-size: 3.25rem;
    }

    &:not(:last-child) {
      margin-block-end: 40px;

      @container main-container (width >= 1024px) {
        margin-block-end: 52px;
      }
    }
  }

  .skills {
    --_bg-line-color: var(--color-dark-line-2);
    --_section-title-color: var(--color-dark-primary-100);

    background-color: var(--color-dark-secondary-100);

    ul:not(.skills-tools):not(.skills-languages) {
      padding-inline-start: 24px;
    }
  }

  .skills-group {
    > * {
      &:not(:last-child) {
        margin-block-end: 24px;

        @container main-container (width >= 1024px) {
          margin-block-end: 12px;
        }
      }
    }
  }

  .skills-languages {
    li {
      display: flex;
      align-items: center;
      gap: 8px;

      &:not(:last-child) {
        margin-block-end: 16px;
      }

      img {
        min-width: 24px;
        max-width: 24px;
        height: 16px;
      }
    }
  }

  .skills-tools {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 22px;
    padding-inline-start: 0;

    img {
      display: block;
      width: 32px;
      height: 32px;
    }
  }

  .text-window {
    &:not(:last-child) {
      margin-block-end: 24px;
    }
  }

  @keyframes blink-caret {
      from, to { border-color: transparent; }
      50% { border-color: var(--color-dark-secondary-100); }
    }
</style>
