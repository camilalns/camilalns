---
import { getCollection } from "astro:content";

import BaseHead from "@/components/BaseHead.astro";
import CardProject from "@/components/CardProject.astro";
import ContainerText from "@/components/ContainerText.astro";
import FloatingIcons from "@/components/FloatingIcons.astro";
import Footer from "@/components/Footer.astro";
import GridProjects from "@/components/GridProjects.astro";
import GridSkills from "@/components/GridSkills.astro";
import Header from "@/components/Header.astro";
import WindowBox from "@/components/WindowBox.astro";

import dataSkills from "@/data/skills.json";

import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";

const skillsTextFirstColumn = [dataSkills.tecnicas, dataSkills.estrategicas];

const skillsTextSecondColumn = [dataSkills.analiticas, dataSkills.soft];

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="container">
          <p class="hero-sub-title text-pixel">
          Product Designer em São Paulo, SP
          </p>
          <h1 class="hero-title">
            Olá! Sou a <span>Camila</span> e design é minha ferramenta para criar <span>experiências</span> que conectam pessoas e negócios.
          </h1>
        </div>
      </section>
      <section class="projects section-container" id="meu-trabalho">
        <div class="container">
          <h2 class="section-title text-pixel">Meu trabalho</h2>
          <GridProjects>
            {
              posts.map((post) => (
                <CardProject
                  title={post.data.title}
                  area={post.data.area}
                  image={post.data.heroImage}
                  link={`/blog/${post.id}/`}
                />
              ))
            }
          </GridProjects>
        </div>
      </section>
      <section class="more section-container" id="sobre-mim">
        <div class="container">
          <ContainerText>
            <WindowBox
              slot="window-element"
              title="Minha jornada"
              variant="dark"
            >
              <p class="text-window">
                Sou <strong>pós-graduada em User Experience Design pela PUCRS</strong> e <strong>atuo há 10 anos na área de tecnologia</strong>. Tenho formação em <strong>Análise e Desenvolvimento de Sistemas</strong> e iniciei minha carreira como <strong>desenvolvedora front-end</strong>, o que me dá uma base sólida para atuar de forma colaborativa com times de tecnologia.
              <p class="text-window">
                Atuo na interseção entre <strong>usuário, negócio e tecnologia</strong>, com foco em resolver problemas reais por meio de pesquisa, <strong>estratégia e design de produtos escaláveis</strong>.<p class="text-window">
                Como <strong>Product Designer na Natura & CO</strong>, atuo na vertical dedicada às plataformas utilizadas por consultoras de beleza. Anteriormente, fui <strong>Product Designer na Rappi</strong>, com foco na vertical de entregadores, <strong>conduzindo pesquisas em campo, alinhando soluções com stakeholders e prototipando produtos com impacto direto na operação logística da empresa</strong>.
              </p>
            </WindowBox>
            <figure>
              <img
                src="/images/camila-alves.png"
                alt="Camila Alves"
                width="502"
                height="404"
                loading="lazy"
                class="image-window"
              />
            </figure>
          </ContainerText>
        </div>
      </section>
      <section class="skills section-container section-grid-bg">
        <div class="container">
          <h2 class="section-title text-pixel">Habilidades</h2>
          <GridSkills>
            <div class="skills-group">
              {
                skillsTextFirstColumn.map((skill) => {
                  return (
                    <WindowBox title={skill.title}>
                      <ul>
                        {skill.items.map((item) => {
                          return (
                            <li>
                              <strong>{item.strong}</strong>
                              {item.text}
                            </li>
                          );
                        })}
                      </ul>
                    </WindowBox>
                  );
                })
              }
            </div>
            <div class="skills-group">
              {
                skillsTextSecondColumn.map((skill) => {
                  return (
                    <WindowBox title={skill.title}>
                      <ul>
                        {skill.items.map((item) => {
                          return (
                            <li>
                              <strong>{item.strong}</strong>
                              {item.text}
                            </li>
                          );
                        })}
                      </ul>
                    </WindowBox>
                  );
                })
              }
            </div>
            <div class="skills-group">
              <WindowBox title={dataSkills.ferramentas.title}>
                <ul class="skills-tools">
                  {
                    dataSkills.ferramentas.tools.map((item) => {
                      return (
                        <li>
                          <img src={`/svg/logo-${item}.svg`} />
                        </li>
                      );
                    })
                  }
                </ul>
              </WindowBox>
              <WindowBox title={dataSkills.idiomas.title}>
                <ul class="skills-languages">
                  {
                    dataSkills.idiomas.languages.map((item) => {
                      return (
                        <li>
                          <img
                            src={`/images/flag-${item.flag}.webp`}
                          />
                          {item.text}
                        </li>
                      );
                    })
                  }
                </ul>
              </WindowBox>
            </div>
          </GridSkills>
        </div>
      </section>
      <section class="more section-container">
        <div class="container">
          <ContainerText>
            <WindowBox
              slot="window-element"
              title="Um pouco de mim"
              variant="dark"
            >
              <p class="text-window">
              Curiosa por natureza, meus hobbies são uma extensão do meu olhar criativo e da forma como observo o mundo.
              </p>
              <p class="text-window">
              A música é minha parceira fiel, e a fotografia é onde consigo capturar o mundo do jeito que vejo, sempre com um toque vintage.
              </p>
              <p class="text-window">
                A moda é outra paixão, uma forma de colocar minha criatividade
                para jogo todos os dias (mesmo quando é sobre escolher um look
                confortável). Também sou fã de momentos como devorar livros em
                cafeterias superfaturadas ou assistir a todos os filmes que
                estão em cartaz. Ah, e recentemente descobri o pilates que tem
                me desafiado de uma forma que me deixa renovada.
              </p>
              <p class="text-window">
                Explorar um mundo de possibilidades é o que me mantém inspirada
                e renovada.
              </p>
            </WindowBox>
            <FloatingIcons />
          </ContainerText>
        </div>
      </section>
    </main>
    <Footer showLargeContent={true} />

    <script>
      const palavras = ["soluções", "experiências", "produtos"];
      const textElement = document.getElementById("text");
      let palavraIndex = 0;
  
      function digitarTexto(texto: string, callback: () => void) {
        let i = 0;
        const intervalo = setInterval(() => {
          (textElement as HTMLElement).textContent += texto.charAt(i);
          i++;
          if (i === texto.length) {
            clearInterval(intervalo);
            setTimeout(callback, 5000); // espera antes de apagar
          }
        }, 100);
      }
  
      function apagarTexto(callback: () => void) {
        let texto = (textElement as HTMLElement).textContent;
        let i = texto ? texto?.length : 0;
        const intervalo = setInterval(() => {
          (textElement as HTMLElement).textContent = texto ? texto.substring(0, i - 1) : null;

          i--;

          if (i === 0) {
            clearInterval(intervalo);
            callback();
          }
        }, 50);
      }
  
      function loop() {
        digitarTexto(palavras[palavraIndex], () => {
          apagarTexto(() => {
            palavraIndex = (palavraIndex + 1) % palavras.length;
            loop();
          });
        });
      }
  
      loop();
    </script>

  </body>
</html>



<style>
  .blink {
    white-space: nowrap;
    overflow: hidden;
    border-right: 2px solid var(--color-dark-secondary-100);
    animation: blink-caret 0.7s step-end infinite;
  }

  .hero {
    padding-block: 32px;
    text-align: center;

    @container main-container (width >= 1024px) {
      padding-block: 136px;
    }

    .hide {
      @container main-container (width >= 1024px) {
        display: none;
      } 
    }
  }

  .hero-title {
    max-width: 920px;
    margin-inline: auto;
    font-weight: 700;
    font-size: 1.75rem;
    text-shadow: #ffffff25 1px 0 10px;

    @container main-container (width >= 1024px) {
      font-size: 3rem;
    }

    span {
      color: var(--color-dark-secondary-100);
    }
  }

  .hero-sub-title {
    font-weight: 500;
    font-size: 1rem;
    text-shadow: #ffffff25 1px 0 10px;

    @container main-container (width >= 1024px) {
      font-size: 1.25rem;
    }

    &:not(:last-child) {
      margin-block-end: 24px;
    }
  }

  .more {
    overflow: hidden;
  }

  .section-container {
    padding-block: 80px;

    @container main-container (width >= 1024px) {
      padding-block: 120px;
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 300;
    color: var(--_section-title-color, var(--color-white));

    @container main-container (width >= 1024px) {
      font-size: 3.25rem;
    }

    &:not(:last-child) {
      margin-block-end: 40px;

      @container main-container (width >= 1024px) {
        margin-block-end: 52px;
      }
    }
  }

  .skills {
    --_bg-line-color: var(--color-dark-line-2);
    --_section-title-color: var(--color-dark-primary-100);

    background-color: var(--color-dark-secondary-100);

    ul:not(.skills-tools):not(.skills-languages) {
      padding-inline-start: 24px;
    }
  }

  .skills-group {
    > * {
      &:not(:last-child) {
        margin-block-end: 24px;

        @container main-container (width >= 1024px) {
          margin-block-end: 12px;
        }
      }
    }
  }

  .skills-languages {
    li {
      display: flex;
      align-items: center;
      gap: 8px;

      &:not(:last-child) {
        margin-block-end: 16px;
      }

      img {
        min-width: 24px;
        max-width: 24px;
        height: 16px;
      }
    }
  }

  .skills-tools {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 22px;
    padding-inline-start: 0;

    img {
      display: block;
      width: 32px;
      height: 32px;
    }
  }

  .text-window {
    &:not(:last-child) {
      margin-block-end: 24px;
    }
  }

  @keyframes blink-caret {
      from, to { border-color: transparent; }
      50% { border-color: var(--color-dark-secondary-100); }
    }
</style>
